// Arduino Nano — 2-sensor bang-bang line follower (TB6612-style driver)
// Pins (change if you wire differently)
const int STBY = 4;

// Left motor
const int AIN1 = 7;
const int AIN2 = 8;
const int PWMA = 9;   // must be a PWM pin

// Right motor
const int BIN1 = 5;
const int BIN2 = 6;
const int PWMB = 10;  // PWM pin

// Sensors (digital: 1 = BLACK, 0 = WHITE) — invert if yours are opposite
const int S_LEFT  = 2;
const int S_RIGHT = 3;

// Speed caps (0..255)
int BASE = 160;       // straight speed
int TURN = 200;       // turning wheel speed (other wheel slowed)

void setup() {
  pinMode(STBY, OUTPUT);
  pinMode(AIN1, OUTPUT); pinMode(AIN2, OUTPUT); pinMode(PWMA, OUTPUT);
  pinMode(BIN1, OUTPUT); pinMode(BIN2, OUTPUT); pinMode(PWMB, OUTPUT);
  pinMode(S_LEFT, INPUT_PULLUP);
  pinMode(S_RIGHT, INPUT_PULLUP);

  digitalWrite(STBY, HIGH);     // enable driver
  // Optional: raise PWM freq on Timer1 for pins 9/10 (~31 kHz)
  TCCR1B = (TCCR1B & 0b11111000) | 0x01;  // prescaler = 1
}

void driveLeft(int speed) {   // speed: -255..255
  if (speed >= 0) {
    digitalWrite(AIN1, HIGH); digitalWrite(AIN2, LOW);
    analogWrite(PWMA, speed);
  } else {
    digitalWrite(AIN1, LOW);  digitalWrite(AIN2, HIGH);
    analogWrite(PWMA, -speed);
  }
}

void driveRight(int speed) {
  if (speed >= 0) {
    digitalWrite(BIN1, HIGH); digitalWrite(BIN2, LOW);
    analogWrite(PWMB, speed);
  } else {
    digitalWrite(BIN1, LOW);  digitalWrite(BIN2, HIGH);
    analogWrite(PWMB, -speed);
  }
}

void loop() {
  int L = digitalRead(S_LEFT);   // 1 = black, 0 = white  (change if inverted)
  int R = digitalRead(S_RIGHT);

  if (L && R) {
    // Both on black → go straight
    driveLeft(BASE);
    driveRight(BASE);
  } else if (L && !R) {
    // Line is under LEFT only → steer LEFT (slow left, speed right)
    driveLeft(BASE / 4);
    driveRight(TURN);
  } else if (!L && R) {
    // Line is under RIGHT only → steer RIGHT
    driveLeft(TURN);
    driveRight(BASE / 4);
  } else {
    // Both white → we lost the line → last-known bias (simple recovery)
    // Here: keep creeping forward
    driveLeft(BASE / 3);
    driveRight(BASE / 3);
  }
}
